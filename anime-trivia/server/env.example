# ============================================
# OPCIÓN 1: Service Account JSON completo (RECOMENDADO - MÁS FÁCIL)
# ============================================
# 1. Ve a Firebase Console → Settings → Service accounts
# 2. Click "Generate new private key"
# 3. Se descarga un archivo JSON
# 4. Copia TODO el contenido del JSON en una sola línea y pégalo aquí:
# 
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"anime-trivia-a7bb7","private_key_id":"abc123...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-xxxxx@anime-trivia-a7bb7.iam.gserviceaccount.com"}

# ============================================
# OPCIÓN 2: Variables individuales (si la opción 1 no funciona)
# ============================================
PORT=4000
FIREBASE_PROJECT_ID=anime-trivia-a7bb7
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@anime-trivia-a7bb7.iam.gserviceaccount.com
# IMPORTANTE: La private key debe tener \\n literales, no saltos de línea reales
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU-LLAVE-AQUI\n-----END PRIVATE KEY-----\n"

# ============================================
# Webhook Secret
# ============================================
WEBHOOK_SECRET=super-secret-token
